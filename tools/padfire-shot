#!/usr/bin/env python3
"""padfire-shot -- render the Padfire window to a PNG and exit.

Builds the real UI, grabs one frame, and quits. Nothing is clicked, no audio is
played, no MIDI device is opened, and the tray is never registered. Intended
for UI review, regression screenshots, and automated inspection.

    tools/padfire-shot                     # -> /tmp/padfire-shot.png
    tools/padfire-shot -o /tmp/ui.png
    tools/padfire-shot --demo              # throwaway HOME with sample pads
    tools/padfire-shot --crop 60           # also write a 60% centre crop
    tools/padfire-shot --scale 250         # also write a 2.5x point-scaled copy

Why this exists: Padfire is a GTK3 app, so "does the UI actually look right?"
cannot be answered by reading source. This makes a screenshot one command.

Exit status: 0 on success, 1 if no usable display could be opened.
"""
import argparse, glob, hashlib, importlib.util, json, os, shutil, subprocess, sys, tempfile, wave
from pathlib import Path

HERE      = Path(__file__).resolve().parent
REPO      = HERE.parent
if str(REPO) not in sys.path:
    sys.path.insert(0, str(REPO))
PADFIRE   = REPO / "padfire.py"
READY_ENV = "PADFIRE_SHOT_READY"


def log(msg):
    print(f"[shot] {msg}", flush=True)


# ---------------------------------------------------------------- display

def _xauth_candidates():
    """Plausible X authority files, best first.

    On a Wayland session the cookie that actually works for XWayland is
    normally one of the /run/user/<uid>/ ones, not ~/.Xauthority.
    """
    uid = os.getuid()
    run = f"/run/user/{uid}"
    out = []
    if os.environ.get("XAUTHORITY"):
        out.append(os.environ["XAUTHORITY"])
    out += sorted(glob.glob(f"{run}/xauth_*"))
    out += sorted(glob.glob(f"{run}/.mutter-Xwaylandauth.*"))
    out += [f"{run}/gdm/Xauthority", str(Path.home() / ".Xauthority")]
    return [p for p in dict.fromkeys(out) if os.path.isfile(p)]


_PROBE = (
    "import sys, gi\n"
    "gi.require_version('Gtk','3.0'); gi.require_version('Gdk','3.0')\n"
    "from gi.repository import Gtk, Gdk\n"
    "ok, _ = Gtk.init_check([])\n"
    "sys.exit(0 if ok and Gdk.Screen.get_default() is not None else 1)\n"
)


def _probe(display, xauth):
    """Test one display/cookie pair in a child process.

    This has to be a child: a failed Gtk.init_check() latches inside GDK, so
    every later attempt in the same process fails too, even with correct
    credentials. Probing in-process and then rendering was the bug that made
    the first version of this script unusable on a Wayland session.
    """
    env = dict(os.environ)
    env["GDK_BACKEND"] = "x11"
    env["DISPLAY"]     = display
    env["XAUTHORITY"]  = xauth
    env.pop("BROADWAY_DISPLAY", None)
    r = subprocess.run([sys.executable, "-c", _PROBE], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return r.returncode == 0


def ensure_display():
    """Guarantee this process can open a display, re-execing if needed."""
    if os.environ.get(READY_ENV):
        import gi
        gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
        from gi.repository import Gtk, Gdk
        ok, _ = Gtk.init_check([])
        if ok and Gdk.Screen.get_default() is not None:
            return True
        log("display went away between probe and render")
        return False

    uid = os.getuid()
    os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    display = os.environ.get("DISPLAY") or ":0"

    cands = _xauth_candidates()
    if not cands:
        cands = [""]                      # unauthenticated / already-permitted
    for xauth in cands:
        if _probe(display, xauth):
            log(f"display {display}" + (f" via {xauth}" if xauth else ""))
            os.environ[READY_ENV]     = "1"
            os.environ["GDK_BACKEND"] = "x11"
            os.environ["DISPLAY"]     = display
            if xauth: os.environ["XAUTHORITY"] = xauth
            os.environ.pop("BROADWAY_DISPLAY", None)
            # restart with a known-good environment and a clean GDK
            os.execv(sys.executable,
                     [sys.executable, str(Path(__file__).resolve())] + sys.argv[1:])

    log(f"could not open display {display}.")
    log("  Run this from inside your desktop session, or set DISPLAY/XAUTHORITY.")
    log(f"  Tried {len(cands)} authority file(s).")
    return False


# ---------------------------------------------------------------- demo cfg

def build_demo_home():
    """Isolated HOME whose config exercises every pad state at once: plain,
    coloured, playing, missing-file, long-name, script, and the stop pads."""
    home = Path(tempfile.mkdtemp(prefix="padfire-shot-home-"))
    snd  = home / "sounds"; snd.mkdir(parents=True)
    (home / ".config" / "padfire").mkdir(parents=True)

    def wav(name):
        """Write 0.1s of silence: a real, openable WAV with no external tools."""
        p = snd / name
        with wave.open(str(p), "wb") as w:
            w.setnchannels(2); w.setsampwidth(2); w.setframerate(44100)
            w.writeframes(b"\x00\x00\x00\x00" * 4410)
        return str(p)

    page0 = {
        "0":   {"action": "play", "file": wav("airhorn.wav"), "label": "Airhorn",
                "vol": 80, "color": "default"},
        "1":   {"action": "play", "file": wav("vineboom.wav"), "label": "Vine Boom",
                "vol": 90, "color": "red"},
        "2":   {"action": "play", "file": wav("bruh.wav"), "label": "Bruh",
                "vol": 80, "color": "green"},
        "3":   {"action": "play", "file": str(snd / "deleted.wav"),
                "label": "Missing File", "vol": 80, "color": "default"},
        "4":   {"action": "play", "file": wav("applause.wav"),
                "label": "Extremely Long Pad Name", "vol": 70, "color": "orange"},
        "5":   {"action": "play", "file": wav("loop.wav"), "label": "Looper",
                "vol": 60, "loop": True, "color": "amber"},
        "16":  {"action": "script", "cmd": "/bin/true",
                "label": "clicker settings", "color": "default"},
        "17":  {"action": "script", "cmd": "/bin/true",
                "label": "clicker toggle", "color": "default"},
        "18":  {"action": "stop_sfx", "label": "Stop SFX", "color": "default"},
        "19":  {"action": "stop_all", "label": "Stop All", "color": "default"},
        "20":  {"action": "stop_key", "label": "Kill AH", "stop_key": "0:0",
                "color": "default"},
        "120": {"action": "stop_all", "label": "stawp", "color": "green"},
    }
    cfg = {
        "version": 5,
        "default_sink": "vm_game",
        "stop_on_page_change": False,
        "retrigger": "restart",
        "monitor_enabled": True,
        "monitor_sink": "vm_music",
        "pages": [page0, {}, {}, {"0": dict(page0["0"])}, {}, {}, {}, {}],
    }
    (home / ".config" / "padfire" / "padfire.json").write_text(json.dumps(cfg, indent=2))
    return home


# ---------------------------------------------------------------- capture

STUB_SINKS = ["vm_game", "vm_chat", "vm_music", "mic_b1",
              "alsa_output.pci-0000_00_1f.3.analog-stereo"]


def _is_blank(path):
    """True when every pixel is the same colour, i.e. nothing was rendered.

    Cheap insurance against the failure this tool actually hit: an on-screen
    grab of a non-visible window yields solid black and still looks like a
    successful capture.
    """
    try:
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file(str(path))
        data = pb.get_pixels()
        if not data:
            return True
        nch, stride = pb.get_n_channels(), pb.get_rowstride()
        width, height = pb.get_width(), pb.get_height()
        first = bytes(data[:nch])
        for y in range(height):
            base = y * stride
            row = data[base:base + width * nch]
            for x in range(0, len(row), nch):
                if bytes(row[x:x + nch]) != first:
                    return False
        return True
    except Exception as exc:
        # A failed check must not masquerade as a failed capture.
        log(f"blank-frame check could not run: {exc}")
        return False


def capture(out, playing=(), settle_ms=600):
    from gi.repository import Gtk, Gdk, GLib

    if not PADFIRE.exists():
        log(f"missing {PADFIRE}"); return False

    spec = importlib.util.spec_from_file_location("padfire_mod", str(PADFIRE))
    mod  = importlib.util.module_from_spec(spec)
    sys.modules["padfire_mod"] = mod
    spec.loader.exec_module(mod)     # module level only; main() is __main__-guarded
    log(f"loaded padfire.py VER={getattr(mod, 'VER', '?')}")

    # Neutralise everything with a side effect outside this process.
    mod.PadfireApp._start_midi      = lambda self: None
    mod.PadfireApp._start_ipc       = lambda self: None
    mod.PadfireApp._start_vu        = lambda self: None
    mod.PadfireApp._start_rac_probe = lambda self: None
    mod.PadfireApp._setup_tray      = lambda self: None
    mod.AudioEngine._refresh_sinks  = lambda self: setattr(self, "_sinks", list(STUB_SINKS))

    live = set(playing)
    mod.AudioEngine.is_playing = lambda self, key: key in live
    if live:
        _orig = mod.AudioEngine.__init__
        def _init(self):
            _orig(self)
            self._procs.update({k: None for k in live})   # drives the status line
        mod.AudioEngine.__init__ = _init

    app = mod.PadfireApp()
    win = app._win
    win.set_decorated(False)         # no WM titlebar in the capture
    win.show_all()

    # Settle with a real main loop. Spinning on Gtk.main_iteration_do(False)
    # drains queued events but never lets GTK's frame clock complete a
    # measure -> allocate -> draw cycle, so widget->priv->alloc_needed stayed
    # set and gtk_widget_draw() aborted with
    #   Gtk-CRITICAL: assertion '!widget->priv->alloc_needed' failed
    # producing a completely unpainted surface.
    GLib.timeout_add(max(1, settle_ms), Gtk.main_quit)
    Gtk.main()

    # Guarantee the measure pass is finished before drawing.
    win.get_preferred_size()
    while Gtk.events_pending():
        Gtk.main_iteration_do(False)

    gwin = win.get_window()
    if gwin is None:
        log("window has no backing GdkWindow"); return False
    w, h = gwin.get_width(), gwin.get_height()
    log(f"window {w}x{h}")

    # Draw the widget tree directly. Unlike an on-screen grab this does not
    # care whether the window is visible, so a blanked or locked screen no
    # longer turns the capture into a black rectangle.
    import cairo
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    win.draw(cairo.Context(surface))
    surface.flush()
    surface.write_to_png(str(out))
    log("rendered via cairo")

    if _is_blank(out):
        # Keep the old path as a fallback: on some themes a top-level window
        # defers part of its drawing to the compositor.
        log("cairo frame was blank -- trying an on-screen grab")
        pb = Gdk.pixbuf_get_from_window(gwin, 0, 0, w, h)
        if pb is not None:
            pb.savev(str(out), "png", [], [])

    if _is_blank(out):
        log("BLANK CAPTURE -- not reporting this as a screenshot.")
        log("  The window rendered nothing. Check whether the screen is")
        log("  blanked or the session is locked:  xset -q | grep -i monitor")
        try:
            win.destroy()
        except Exception:
            pass
        return False

    try: win.destroy()
    except Exception: pass
    return True


def post(out, scale=None, crop=None):
    """Optional centre-cropped and/or point-scaled copies via ImageMagick."""
    magick = shutil.which("magick") or shutil.which("convert")
    made = []
    if not magick:
        if scale or crop: log("ImageMagick not found; skipping crop/scale")
        return made
    if crop:
        pct = str(crop).strip().rstrip("%")
        c = out.with_name(out.stem + f"-crop{pct}.png")
        subprocess.run([magick, str(out), "-gravity", "center",
                        "-crop", f"{pct}%x{pct}%+0+0", "+repage", str(c)], check=False)
        if c.exists(): made.append(c)
    if scale:
        s = out.with_name(out.stem + f"-{scale}pct.png")
        subprocess.run([magick, str(out), "-filter", "point",
                        "-resize", f"{scale}%", str(s)], check=False)
        if s.exists(): made.append(s)
    return made


def report(p):
    b = p.read_bytes()
    print(f"{p}  {len(b)} bytes  sha256={hashlib.sha256(b).hexdigest()}")


def main():
    ap = argparse.ArgumentParser(prog="padfire-shot",
                                 description="Screenshot the Padfire window.")
    ap.add_argument("-o", "--out", default="/tmp/padfire-shot.png",
                    help="output PNG (default: /tmp/padfire-shot.png)")
    ap.add_argument("--demo", action="store_true",
                    help="use a throwaway HOME with sample pads covering every "
                         "pad state; never touches your real config")
    ap.add_argument("--playing", default="",
                    help='pad keys to render as playing, e.g. "0:1,0:5"')
    ap.add_argument("--scale", type=int, default=None,
                    help="also write a point-scaled copy, e.g. 250 for 2.5x")
    ap.add_argument("--crop", default="60",
                    help='also write a centre crop percentage, e.g. 60')
    ap.add_argument("--settle", type=int, default=1000,
                    help="ms to let GTK settle before capture (default 600)")
    args = ap.parse_args()

    # Display first: this may re-exec, and anything created before that leaks.
    if not ensure_display():
        return 1

    out = Path(args.out).expanduser().resolve()
    out.parent.mkdir(parents=True, exist_ok=True)

    tmp_home = None
    try:
        if args.demo:
            tmp_home = build_demo_home()
            os.environ["HOME"] = str(tmp_home)   # before padfire.py is imported
            log(f"demo HOME {tmp_home}")

        playing = [k for k in (s.strip() for s in args.playing.split(",")) if k]
        if args.demo and not playing:
            playing = ["0:1"]                    # Vine Boom, so the ring shows

        if not capture(out, playing=playing, settle_ms=args.settle):
            return 1
        report(out)
        for extra in post(out, scale=args.scale, crop=args.crop):
            report(extra)
        return 0
    finally:
        if tmp_home:
            shutil.rmtree(tmp_home, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
